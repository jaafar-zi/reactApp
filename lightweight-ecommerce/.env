# .env
# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=admin
DB_PASSWORD=admin@*123
DB_POOL_SIZE=10

# Spring Profile
SPRING_PROFILE=dev

# Server Configuration
SERVER_PORT=8080
CONTEXT_PATH=/

# Mail Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=jawistaclub@gmail.com
MAIL_PASSWORD=ccaq yezy ghqz opaj
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_DEBUG=false
MAIL_ENABLED=true
MAIL_FROM_EMAIL=jawistaclub@gmail.com
MAIL_FROM_NAME=jawista Store

# Security Configuration
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin123
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION_MS=86400000

# Application Configuration
APP_DEFAULT_LANGUAGE=en
APP_SUPPORTED_LANGUAGES=en,fr,es,de
FRONTEND_URL= http://localhost:8888
COMPANY_NAME=Jawista club
SUPPORT_EMAIL=jawistaclub@gmail.com

# JPA Configuration
JPA_SHOW_SQL=false

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_SPRING_SECURITY=DEBUG
LOG_LEVEL_HIBERNATE=WARN
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BINDER=TRACE
LOG_FILE=logs/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=30

# Thymeleaf
THYMELEAF_CACHE=false